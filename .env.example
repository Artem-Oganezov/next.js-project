# ── MongoDB ──────────────────────────────────────────────────────────────
# Source of truth (users, records, sessions). Keep it OFF the app server:
# Atlas (free M0 to start) or a separate VPS — new app nodes connect without migrating data.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/game?retryWrites=true&w=majority
# Local: MONGODB_URI=mongodb://127.0.0.1:27017/game

# ── Auth ─────────────────────────────────────────────────────────────────
# At least 32 characters: openssl rand -base64 32
# IMPORTANT: with multiple app servers, AUTH_SECRET must be IDENTICAL on all nodes,
# otherwise sessions created on one server will be rejected by another.
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ── Redis (hot path: rate limit, leaderboard, rank) ───────────────────────
# Provide ONE of the following:

# Option 1 — TCP (VPS / docker compose / managed Redis).
# In docker compose: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# Option 2 — Upstash REST (serverless deploy).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# With multiple app servers, Redis must also be SHARED (one instance for all nodes),
# otherwise rate limits and ranks diverge between nodes.

# ── Rate limiting ────────────────────────────────────────────────────────
# Default is fail-open: unavailable Redis does NOT crash the API, but also does not limit.
# true — strict mode: requests under the limit receive 429 when Redis is down.
# RATE_LIMIT_FAIL_CLOSED=true

# Trust X-Forwarded-For / X-Real-IP (only behind a reverse proxy: nginx, Caddy).
# Without a proxy, leave false — otherwise clients can spoof IP and bypass limits.
# TRUST_PROXY=true

# ── Admin / metrics ──────────────────────────────────────────────────────
# Secret for /api/admin/* and protecting /api/metrics in production.
# ADMIN_SECRET=change-me-to-another-long-random-secret-32-chars-min

# ── App URL & email (password reset, email verification) ─────────────────
# Public app URL — used in email links and Open Graph metadata.
# APP_URL=https://your-domain.com

# SMTP (optional). Without SMTP, emails are logged to stdout (dev / Docker logs).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-password
# EMAIL_FROM=noreply@your-domain.com

# ── Revive ads (client-side, optional) ───────────────────────────────────
# stub — fake delay for dev/CI (default)
# slot  — mount point + window events for your ad script (see docs/ADS.md)
# none  — hide “Watch ad”, save-score only
# NEXT_PUBLIC_REVIVE_AD_PROVIDER=stub
# NEXT_PUBLIC_REVIVE_AD_STUB_MS=1200
# NEXT_PUBLIC_REVIVE_AD_SLOT_ID=revive-ad-slot
