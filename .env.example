# MongoDB Atlas (production / Vercel)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dino-game?retryWrites=true&w=majority

# Local Docker alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/dino

# Minimum 32 characters — generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
