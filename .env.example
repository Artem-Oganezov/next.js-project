# ── Copy to .env.local and fill in real values (never commit .env.local) ──
#
# Generate secrets:
#   openssl rand -hex 32   (AUTH_SECRET, ADMIN_SECRET)

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dino-game?retryWrites=true&w=majority
# Local: MONGODB_URI=mongodb://127.0.0.1:27017/game
# MONGODB_MAX_POOL_SIZE=50

# ── Auth (required) ──────────────────────────────────────────────────────
AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ── Redis (required — pick ONE option) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=https://YOUR-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_upstash_rest_token
# TCP alternative: REDIS_URL=redis://127.0.0.1:6379

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_FAIL_CLOSED=true
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_SCORE_MAX=30
# RATE_LIMIT_SCORE_STATUS_MAX=120
# RATE_LIMIT_LEADERBOARD_MAX=60
# RATE_LIMIT_HEALTH_MAX=30
# RATE_LIMIT_ME_MAX=60
# RATE_LIMIT_LOGIN_USER_MAX=5
# RESEND_VERIFY_COOLDOWN_MS=300000

# ── Reverse proxy / client IP ────────────────────────────────────────────
# false for npm run dev / k6 on localhost; true ONLY behind nginx/Caddy.
TRUST_PROXY=false

# ── Admin / metrics (required in all environments) ───────────────────────
ADMIN_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ── Anti-cheat / revive ──────────────────────────────────────────────────
# Auto-ban after N rejected submits in the window (default 8 per hour).
# ANTI_CHEAT_AUTO_BAN_THRESHOLD=8
# ANTI_CHEAT_AUTO_BAN_WINDOW_SEC=3600
# Minimum wait between revive challenge and claim (ms).
# REVIVE_CHALLENGE_MIN_MS=1000

# ── Async score queue (requires TCP REDIS_URL — not Upstash-only) ───────
# SCORE_ASYNC=true
# SCORE_WORKER_CONCURRENCY=2

# ── Email verification (optional in dev) ─────────────────────────────────
# REQUIRE_EMAIL_VERIFICATION=true

# ── App URL & email ──────────────────────────────────────────────────────
# APP_URL=http://localhost:3000
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@your-domain.com

# ── Google OAuth (optional) ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Revive ads (client-side) ─────────────────────────────────────────────
NEXT_PUBLIC_REVIVE_AD_PROVIDER=none
# NEXT_PUBLIC_REVIVE_AD_PROVIDER=stub
# NEXT_PUBLIC_REVIVE_AD_STUB_MS=1200
