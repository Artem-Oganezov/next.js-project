# ── MongoDB ──────────────────────────────────────────────────────────────
# Источник правды (юзеры, рекорды, сессии). Держи ВНЕ app-сервера:
# Atlas (free M0 для старта) или отдельный VPS — тогда новые app-ноды
# подключаются без переноса данных.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/game?retryWrites=true&w=majority
# Локально: MONGODB_URI=mongodb://127.0.0.1:27017/game

# ── Auth ─────────────────────────────────────────────────────────────────
# Минимум 32 символа: openssl rand -base64 32
# ВАЖНО: при нескольких app-серверах секрет должен быть ОДИНАКОВЫМ на всех,
# иначе сессии одного сервера не примутся другим.
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ── Redis (hot path: rate limit, лидерборд, ранг) ────────────────────────
# Нужен ОДИН из вариантов:

# Вариант 1 — TCP (VPS / docker compose / managed Redis).
# В docker compose: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# Вариант 2 — Upstash REST (serverless-деплой).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# При нескольких app-серверах Redis тоже должен быть ОБЩИМ (один на всех),
# иначе rate limit и рейтинг разъедутся между нодами.

# ── Rate limiting ────────────────────────────────────────────────────────
# По умолчанию fail-open: недоступный Redis НЕ роняет API, но и не лимитирует.
# true — жёсткий режим: при падении Redis запросы под лимитом получают 429.
# RATE_LIMIT_FAIL_CLOSED=true

# ── Admin / metrics ──────────────────────────────────────────────────────
# Секрет для /api/admin/* и защиты /api/metrics в production.
# ADMIN_SECRET=change-me-to-another-long-random-secret-32-chars-min
