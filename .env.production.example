# ── Production environment template (VPS + Docker) ───────────────────────
# On your server:
#   cp .env.production.example .env
#   nano .env   # fill every empty value below
#   docker compose up -d --build
#
# Never commit real secrets to git.

# ── MongoDB (required) ───────────────────────────────────────────────────
MONGODB_URI=

# ── Auth (required) ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# MUST be identical on every app node behind a load balancer.
AUTH_SECRET=

# ── Redis (required) ─────────────────────────────────────────────────────
# Docker compose service name:
REDIS_URL=redis://redis:6379

# ── Production hardening (required) ──────────────────────────────────────
APP_URL=https://your-domain.com
TRUST_PROXY=true
RATE_LIMIT_FAIL_CLOSED=true
ADMIN_SECRET=

# ── Async score queue (recommended for traffic spikes) ───────────────────
# Requires the worker service: docker compose up -d worker
# See docs/INFLUENCER-LAUNCH.md
SCORE_ASYNC=true

# ── Email (required for password reset and verification) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@your-domain.com

# ── Revive ads — Google Ad Manager (monetization) ────────────────────────
# none | stub | slot — NEXT_PUBLIC_* is baked in at Docker build; rebuild after changes.
NEXT_PUBLIC_REVIVE_AD_PROVIDER=slot

# From Google Ad Manager → Inventory → Ad units (copy your values):
NEXT_PUBLIC_GAM_AD_UNIT_PATH=
# Or split:
# NEXT_PUBLIC_GAM_NETWORK_ID=
# NEXT_PUBLIC_GAM_AD_UNIT_NAME=revive_interstitial

# Must match ad unit type in GAM: interstitial or rewarded
NEXT_PUBLIC_GAM_AD_FORMAT=interstitial

NEXT_PUBLIC_REVIVE_AD_SLOT_ID=revive-ad-slot
