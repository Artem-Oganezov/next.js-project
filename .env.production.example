# ── Production environment (VPS + Docker) ────────────────────────────────
#
# On the server:
#   cp .env.production.example .env
#   nano .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Use the SAME .env on every app node if you add a second VPS later.
# Never commit a filled .env to git.

NODE_ENV=production

# ── MongoDB Atlas (required) ─────────────────────────────────────────────
# Whitelist VPS IP(s) in Atlas → Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dino-game?retryWrites=true&w=majority

# Connection pool per app container (2 app instances → keep total under Atlas limit).
MONGODB_MAX_POOL_SIZE=50

# ── Auth (required) ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# MUST be identical on every app node behind the load balancer.
AUTH_SECRET=

# ── Redis — managed TCP (required) ───────────────────────────────────────
# Use your provider URL (Redis Cloud, DO Managed Redis, etc.).
# Prefer TLS in production:
REDIS_URL=rediss://default:PASSWORD@your-redis-host:6379
# Do NOT set UPSTASH_REDIS_REST_* when REDIS_URL is set.

# ── App URL & proxy (required) ───────────────────────────────────────────
APP_URL=https://your-domain.com
# Required behind nginx / Cloudflare — otherwise rate limits share one IP bucket.
TRUST_PROXY=true

# ── Production hardening (recommended) ─────────────────────────────────────
# Reject requests when Redis is down instead of fail-open rate limiting.
RATE_LIMIT_FAIL_CLOSED=true
# Block gameplay until email is verified (session/start + score).
REQUIRE_EMAIL_VERIFICATION=true
# Admin panel (/admin) and /api/metrics — min 32 characters.
ADMIN_SECRET=

# Optional rate limit tuning (defaults: 10 auth/min, 30 score/min per key):
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_SCORE_MAX=30

# ── Async score queue (recommended for traffic spikes) ───────────────────
# Requires TCP REDIS_URL + worker service in docker-compose.prod.yml.
SCORE_ASYNC=true

# ── Email — password reset & verification (required for full auth flow) ───
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@your-domain.com

# ── Revive ads (optional — baked into image at build time) ────────────────
# none | stub | slot — rebuild image after changing NEXT_PUBLIC_* values.
NEXT_PUBLIC_REVIVE_AD_PROVIDER=none

# Google Ad Manager (only when NEXT_PUBLIC_REVIVE_AD_PROVIDER=slot):
# NEXT_PUBLIC_GAM_AD_UNIT_PATH=/NETWORK_ID/AD_UNIT_NAME
# NEXT_PUBLIC_GAM_NETWORK_ID=
# NEXT_PUBLIC_GAM_AD_UNIT_NAME=revive_interstitial
# NEXT_PUBLIC_GAM_AD_FORMAT=interstitial
# NEXT_PUBLIC_REVIVE_AD_SLOT_ID=revive-ad-slot
