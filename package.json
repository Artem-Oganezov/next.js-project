{
  "name": "dino-run",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:worker": "esbuild workers/score-worker.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/score-worker.cjs --packages=external --tsconfig=tsconfig.json",
    "start": "next start",
    "worker:score": "tsx workers/score-worker.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:redis": "vitest run --config vitest.redis.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.1",
    "mongoose": "^9.6.3",
    "next": "15.5.18",
    "nodemailer": "^9.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.81.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "esbuild": "^0.25.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}
